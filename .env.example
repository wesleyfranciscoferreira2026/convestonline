# Aura Study — variáveis de ambiente
# Copie este arquivo para ".env.local" e preencha com as credenciais do seu projeto Supabase
# (Project Settings > API). Use SOMENTE a chave "anon public" aqui — nunca a service_role.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA-CHAVE-ANON-PUBLIC
